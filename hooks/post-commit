#!/bin/bash
# Git post-commit hook: on the first commit of a branch with ENG-XXXX,
# sets Dev Start and moves issue to In Progress on Huly.

HULY_UPDATE="${HULY_DASH_DIR:-$HOME/Projects/agents/huly}/src/huly-update.js"

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [[ -z "$branch" || "$branch" == "main" || "$branch" == "master" ]]; then
  exit 0
fi

# Extract ENG-XXXX from branch name
issue=$(echo "$branch" | grep -oE 'ENG-[0-9]+' | head -1)
if [[ -z "$issue" ]]; then
  exit 0
fi

# Only trigger on the first commit of this branch.
# Check if main has the same HEAD as this branch's merge-base (meaning only 1 commit ahead).
merge_base=$(git merge-base HEAD main 2>/dev/null || git merge-base HEAD master 2>/dev/null)
commits_ahead=$(git rev-list --count "$merge_base"..HEAD 2>/dev/null)
if [[ "$commits_ahead" != "1" ]]; then
  exit 0
fi

echo "🔗 Huly: setting $issue → In Progress (Dev Start)"
node "$HULY_UPDATE" dev-start "$issue" 2>/dev/null &
exit 0
