#!/bin/bash
# Git pre-push hook: detects ENG-XXXX in branch name and sets Dev Start + In Progress on Huly.
# Only fires on the first push of a branch (checks if remote tracking exists).

HULY_UPDATE="${HULY_DASH_DIR:-$HOME/Projects/agents/huly}/src/huly-update.js"

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [[ -z "$branch" ]]; then
  exit 0
fi

# Extract ENG-XXXX from branch name
issue=$(echo "$branch" | grep -oE 'ENG-[0-9]+' | head -1)
if [[ -z "$issue" ]]; then
  exit 0
fi

# Only trigger on first push (no upstream set yet)
upstream=$(git rev-parse --abbrev-ref "@{upstream}" 2>/dev/null)
if [[ -n "$upstream" ]]; then
  exit 0
fi

echo "🔗 Huly: setting $issue → In Progress (Dev Start)"
node "$HULY_UPDATE" dev-start "$issue" 2>/dev/null &
# Run in background so push isn't blocked by API latency
exit 0
